<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow local LAN HTTP sync & desktop preview while keeping system CAs for Google Drive HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

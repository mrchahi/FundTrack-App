# GEMINI_API_KEY: Server-side key for Gemini Cloud Engine (gemini-4-hydrogen / gemini-3.1-flash-lite).
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional server-side API keys for additional advanced OpenAI-compatible model profiles:
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
CUSTOM_AI_API_KEY=""

# Optional Local AI defaults (Jan / llama-server / Ollama)
LOCAL_AI_ENDPOINT="http://127.0.0.1:1337/v1"
LOCAL_AI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
